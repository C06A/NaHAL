  "title": "The Color API",
  "format": {
    "hex": "Valid hex code: 3 or 6 HEX-digits: 0...9,A...F",
    "rgb": "Valid rgb color: 3 numbers between 0 and 255 or rgb(#,#,#)",
    "hsl": "Valid hsl color: number between 0 and 255, percent number, percent number",
    "cmyk": "Valid cmyk color: 4 numbers or cmyk(#,#,#,#)",
    "named": "Boolean. Whether to print the color names on resulting image",
    "mode": "Define mode by which to generate the scheme from the seed color: monochrome, monochrome-dark, monochrome-light, analogic, complement, analogic-complement, triad, quad",
    "count": "Number of colors to return",
    "w": "Height of resulting image, only applicable on SVG format"
  }
